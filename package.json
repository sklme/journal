{
  "name": "journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人技术知识笔记",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:sensitive": "node scripts/check-sensitive.ts --all",
    "check:sensitive:staged": "node scripts/check-sensitive.ts --staged",
    "check:log": "node scripts/check-content-log.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm check:sensitive && pnpm check:log && pnpm typecheck && pnpm docs:build",
    "prepare": "node scripts/setup-hooks.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "vite": "6.4.3"
    }
  }
}

{
  "name": "journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人开发记录与知识笔记",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:sensitive": "node scripts/check-sensitive.mjs --all",
    "check:sensitive:staged": "node scripts/check-sensitive.mjs --staged",
    "check": "pnpm check:sensitive && pnpm docs:build",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}
